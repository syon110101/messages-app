{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "messages-server",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
